{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://affex.local/integration/copy-engine-v3/angle-v7.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["angles"],
  "properties": {
    "angles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "positioning", "rooted_in", "positive_differentiation", "narrative_license", "conversion_spine", "is_recommended"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "positioning": { "type": "string", "minLength": 1 },
          "rooted_in": { "type": "string", "minLength": 1 },
          "positive_differentiation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offer_strength", "offer_strength_source_ids", "market_claim_mode", "market_claim", "market_claim_evidence_ids", "competitor_denigration_used"],
            "properties": {
              "offer_strength": { "type": "string", "minLength": 1 },
              "offer_strength_source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "market_claim_mode": { "enum": ["offer_only", "verified_comparison", "verified_uniqueness"] },
              "market_claim": { "type": ["string", "null"] },
              "market_claim_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "competitor_denigration_used": { "const": false }
            }
          },
          "narrative_license": { "type": "object" },
          "conversion_spine": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["person", "unmet_need_now", "scene_evidence", "consequence_without_offer", "truth_sources", "dominant_emotional_peak", "build_to_peak", "offer_mechanism", "why_offer_is_causal_solution", "unresolved_at_ask", "causal_dependency_test"],
                "properties": {
                  "person": { "type": "string", "minLength": 1 },
                  "unmet_need_now": { "type": "string", "minLength": 1 },
                  "scene_evidence": { "type": "string", "minLength": 1 },
                  "consequence_without_offer": { "type": "string", "minLength": 1 },
                  "truth_sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                  "dominant_emotional_peak": { "type": "string", "minLength": 1 },
                  "build_to_peak": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                  "offer_mechanism": { "type": "string", "minLength": 1 },
                  "why_offer_is_causal_solution": { "type": "string", "minLength": 1 },
                  "unresolved_at_ask": { "type": "string", "minLength": 1 },
                  "causal_dependency_test": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["removed_offer_mechanism", "reader_problem_still_resolves", "explanation"],
                    "properties": {
                      "removed_offer_mechanism": { "type": "string", "minLength": 1 },
                      "reader_problem_still_resolves": { "const": false },
                      "explanation": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              },
              { "type": "null" }
            ]
          },
          "is_recommended": { "type": "boolean" }
        }
      }
    }
  }
}
