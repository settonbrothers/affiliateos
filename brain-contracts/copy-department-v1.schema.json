{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://affx.local/schemas/copy-department-v1.schema.json",
  "title": "CopyDepartmentPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "primary_specialist", "challenger_specialist", "routing_reason", "candidate_briefs", "diversity_limitations"],
  "properties": {
    "schema_version": { "const": "copy-department-v1" },
    "primary_specialist": { "$ref": "#/$defs/specialist" },
    "challenger_specialist": { "oneOf": [{ "$ref": "#/$defs/specialist" }, { "type": "null" }] },
    "routing_reason": { "type": "string", "minLength": 1 },
    "candidate_briefs": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/brief" } },
    "diversity_limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "specialist": { "enum": ["storytelling", "direct_response", "proof_mechanism"] },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "specialist", "test_hypothesis", "reader_change", "evidence_anchor_ids", "spy_influence", "material_difference", "angle_index"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "specialist": { "$ref": "#/$defs/specialist" },
        "test_hypothesis": { "type": "string", "minLength": 1 },
        "reader_change": { "type": "string", "minLength": 1 },
        "evidence_anchor_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "spy_influence": { "type": "string" },
        "material_difference": { "type": "string", "minLength": 1 },
        "angle_index": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
